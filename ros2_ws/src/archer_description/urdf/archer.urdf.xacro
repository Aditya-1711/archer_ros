<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="archer">

  <!-- ========================================================================= -->
  <!-- Archer: Overhauled with Professional 1X Technologies Humanoid Meshes      -->
  <!-- ========================================================================= -->

  <xacro:include filename="materials.xacro" />
  <xacro:include filename="inertials.xacro" />
  <xacro:include filename="archer_gazebo.xacro" />
  <xacro:include filename="archer_control.xacro" />

  <!-- Unified mesh orientation (aligned with local coordinate frames for both Gazebo and RViz) -->
  <xacro:property name="mesh_rpy" value="1.5707963 0 1.5707963"/>

  <!-- Base Link / Frictionless Sled -->
  <link name="base_link">
    <!-- Invisible Sled for Absolute upright stability -->
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.6 0.6 0.01"/></geometry>
      <material name="transparent"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.6 0.6 0.01"/></geometry>
    </collision>
    <xacro:box_inertia m="5.0" w="0.6" h="0.6" d="0.01"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_link"/><child link="Pelvis"/>
    <origin xyz="0 0 0.95" rpy="0 0 0"/>
  </joint>
  
  <gazebo reference="base_link">
    <!-- Frictionless sled to ensure smooth sliding -->
    <mu1>0.0</mu1><mu2>0.0</mu2>
  </gazebo>

  <!-- Pelvis -->
  <link name="Pelvis">
    <!-- Professional 1X Torso Mannequin Mesh -->
    <visual>
      <origin xyz="0 0 0" rpy="${mesh_rpy}"/>
      <geometry>
        <mesh filename="package://archer_description/meshes/torso.obj" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision><geometry><box size="0.2 0.3 0.15"/></geometry></collision>
    <xacro:ballast_inertia m="50.0" w="0.2" h="0.3" d="0.15"/>
  </link>

  <!-- Wheels (Hidden visually inside/under the signature Neo white sneakers) -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="neo_matte_black"/>
    </visual>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <xacro:sphere_inertia m="2.0" r="0.05"/>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel"/>
    <origin xyz="0 0.1 0.05" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="neo_matte_black"/>
    </visual>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <xacro:sphere_inertia m="2.0" r="0.05"/>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel"/>
    <origin xyz="0 -0.1 0.05" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <!-- Torso Segment 1: Lower Trunk (Flexible Waist) -->
  <link name="LowerTrunk">
    <!-- Professional 1X Abdomen Mesh -->
    <visual>
      <origin xyz="0 0 0" rpy="${mesh_rpy}"/>
      <geometry>
        <mesh filename="package://archer_description/meshes/abdomen.obj" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision><geometry><box size="0.15 0.25 0.2"/></geometry></collision>
    <xacro:box_inertia m="5.0" w="0.15" h="0.25" d="0.2"/>
  </link>
  
  <joint name="jL5S1_roty" type="revolute">
    <parent link="Pelvis"/><child link="LowerTrunk"/><axis xyz="0 1 0"/>
    <origin xyz="0 0 0.1"/>
    <limit effort="100" velocity="1.0" lower="-0.5" upper="1.5"/>
    <dynamics damping="1.5" friction="1.0"/>
  </joint>

  <!-- Torso Segment 2: Upper Trunk (Chest / Shoulders) -->
  <link name="UpperTrunk">
    <!-- Professional 1X Scapula / Shoulder Connector Mesh -->
    <visual>
      <origin xyz="0 0 0.1" rpy="${mesh_rpy}"/>
      <geometry>
        <mesh filename="package://archer_description/meshes/scapula.obj" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision><geometry><box size="0.15 0.25 0.2"/></geometry></collision>
    <xacro:box_inertia m="5.0" w="0.15" h="0.25" d="0.2"/>
  </link>

  <joint name="jT9T8_roty" type="revolute">
    <parent link="LowerTrunk"/><child link="UpperTrunk"/><axis xyz="0 1 0"/>
    <origin xyz="0 0 0.2"/>
    <limit effort="100" velocity="1.0" lower="-0.2" upper="0.7"/>
    <dynamics damping="1.5" friction="1.0"/>
  </joint>

  <!-- Head (Sleek Visor Helmet with Emotive Rings) -->
  <link name="Head">
    <!-- Professional 1X Head Mesh -->
    <visual>
      <origin xyz="0 0 0" rpy="${mesh_rpy}"/>
      <geometry>
        <mesh filename="package://archer_description/meshes/head.obj" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision><geometry><sphere radius="0.1"/></geometry></collision>
    <xacro:sphere_inertia m="2.0" r="0.1"/>
  </link>

  <joint name="jT1C7_roty" type="revolute">
    <parent link="UpperTrunk"/><child link="Head"/><axis xyz="0 1 0"/>
    <origin xyz="0 0 0.2"/>
    <limit effort="10" velocity="1.0" lower="-0.5" upper="0.5"/>
    <dynamics damping="1.5" friction="1.0"/>
  </joint>

  <!-- LEGS MACRO (Fully Functional Revolute Thighs, Calves, & Hidden Wheels in Sneakers) -->
  <xacro:macro name="archer_leg" params="side reflect">
    <link name="${side}UpperLeg">
      <!-- Professional 1X Thigh Mesh -->
      <visual>
        <origin xyz="0 0 0" rpy="${mesh_rpy}"/>
        <geometry>
          <mesh filename="package://archer_description/meshes/thigh.obj" scale="1.0 1.0 1.0"/>
        </geometry>
      </visual>
      <collision><geometry><cylinder radius="0.05" length="0.4"/></geometry></collision>
      <xacro:cylinder_inertia m="3.0" r="0.05" l="0.4"/>
    </link>

    <joint name="j${side}Hip_roty" type="revolute">
      <parent link="Pelvis"/><child link="${side}UpperLeg"/><axis xyz="0 1 0"/>
      <origin xyz="0 ${reflect*0.1} -0.1"/>
      <limit effort="50" velocity="1.0" lower="-1.5" upper="0.5"/>
      <dynamics damping="1.5" friction="1.0"/>
    </joint>

    <link name="${side}LowerLeg">
      <!-- Professional 1X Shin Mesh -->
      <visual>
        <origin xyz="0 0 0" rpy="${mesh_rpy}"/>
        <geometry>
          <mesh filename="package://archer_description/meshes/shin.obj" scale="1.0 1.0 1.0"/>
        </geometry>
      </visual>
      
      <!-- signature 1X NEO Athletic Knit Sneaker at bottom -->
      <!-- White sole -->
      <visual>
        <origin xyz="0.04 0 -0.34" rpy="0 0 0"/>
        <geometry><box size="0.22 0.10 0.04"/></geometry>
        <material name="neo_sneaker_white"/>
      </visual>
      <!-- Black sole tread -->
      <visual>
        <origin xyz="0.04 0 -0.36" rpy="0 0 0"/>
        <geometry><box size="0.224 0.104 0.01"/></geometry>
        <material name="neo_matte_black"/>
      </visual>
      <!-- Knit sneaker upper body (Knit grey) -->
      <visual>
        <origin xyz="0.03 0 -0.28" rpy="0 0.15 0"/>
        <geometry><box size="0.18 0.09 0.08"/></geometry>
        <material name="neo_knit_gray"/>
      </visual>
      <!-- Sneaker heel cap wrap (Matte black) -->
      <visual>
        <origin xyz="-0.04 0 -0.29" rpy="0 0 0"/>
        <geometry><box size="0.05 0.092 0.082"/></geometry>
        <material name="neo_matte_black"/>
      </visual>
      <!-- White sneaker collar / ankle cuff -->
      <visual>
        <origin xyz="0 0 -0.22" rpy="0 0 0"/>
        <geometry><cylinder radius="0.045" length="0.04"/></geometry>
        <material name="neo_sneaker_white"/>
      </visual>
      
      <collision><geometry><cylinder radius="0.04" length="0.4"/></geometry></collision>
      <xacro:cylinder_inertia m="2.0" r="0.04" l="0.4"/>
    </link>

    <joint name="j${side}Knee_roty" type="revolute">
      <parent link="${side}UpperLeg"/><child link="${side}LowerLeg"/><axis xyz="0 1 0"/>
      <origin xyz="0 0 -0.4"/>
      <limit effort="50" velocity="1.0" lower="0" upper="2.0"/>
      <dynamics damping="1.5" friction="1.0"/>
    </joint>
  </xacro:macro>

  <xacro:archer_leg side="Left" reflect="1"/>
  <xacro:archer_leg side="Right" reflect="-1"/>

  <!-- ARMS MACRO (Fully Functional Revolute Shoulders & Elbows, with Mitten Hands) -->
  <xacro:macro name="archer_arm" params="side reflect">
    <link name="${side}UpperArm">
      <!-- Professional 1X Upper Arm Mesh -->
      <visual>
        <origin xyz="0 0 0" rpy="${mesh_rpy}"/>
        <geometry>
          <mesh filename="package://archer_description/meshes/upper_arm.obj" scale="1.0 1.0 1.0"/>
        </geometry>
      </visual>
      <collision><geometry><cylinder radius="0.03" length="0.3"/></geometry></collision>
      <xacro:cylinder_inertia m="1.5" r="0.03" l="0.3"/>
    </link>

    <joint name="j${side}Shoulder_roty" type="revolute">
      <parent link="UpperTrunk"/><child link="${side}UpperArm"/><axis xyz="0 1 0"/>
      <origin xyz="0 ${reflect*0.2} 0.1"/>
      <limit effort="30" velocity="1.0" lower="-1.5" upper="1.5"/>
      <dynamics damping="1.5" friction="1.0"/>
    </joint>

    <link name="${side}LowerArm">
      <!-- Professional 1X Forearm Mesh -->
      <visual>
        <origin xyz="0 0 0" rpy="${mesh_rpy}"/>
        <geometry>
          <mesh filename="package://archer_description/meshes/forearm.obj" scale="1.0 1.0 1.0"/>
        </geometry>
      </visual>
      <collision><geometry><cylinder radius="0.02" length="0.3"/></geometry></collision>
      <xacro:cylinder_inertia m="1.0" r="0.02" l="0.3"/>
    </link>

    <joint name="j${side}Elbow_roty" type="revolute">
      <parent link="${side}UpperArm"/><child link="${side}LowerArm"/><axis xyz="0 1 0"/>
      <origin xyz="0 0 -0.3"/>
      <limit effort="30" velocity="1.0" lower="-2.0" upper="0"/>
      <dynamics damping="1.5" friction="1.0"/>
    </joint>

    <!-- Hand (Robotic Mitten styled in high-fidelity 1X Neo aesthetic) -->
    <link name="${side}Hand">
      <!-- Professional 1X Palm Mesh -->
      <visual>
        <origin xyz="0 0 0" rpy="${mesh_rpy}"/>
        <geometry>
          <mesh filename="package://archer_description/meshes/palm.obj" scale="1.0 1.0 1.0"/>
        </geometry>
      </visual>
      <collision><geometry><sphere radius="0.04"/></geometry></collision>
      <xacro:sphere_inertia m="0.5" r="0.04"/>
    </link>
    <joint name="j${side}Wrist_fixed" type="fixed">
      <parent link="${side}LowerArm"/><child link="${side}Hand"/>
      <origin xyz="0 0 -0.15"/>
    </joint>
  </xacro:macro>

  <xacro:archer_arm side="Left" reflect="1"/>
  <xacro:archer_arm side="Right" reflect="-1"/>

</robot>
