<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="archer">

  <!-- ========================================================================= -->
  <!-- Archer: Full Humanoid with Arms & Hands                                 -->
  <!-- ========================================================================= -->

  <xacro:include filename="materials.xacro" />
  <xacro:include filename="inertials.xacro" />
  <xacro:include filename="archer_gazebo.xacro" />

  <link name="base_link">
    <!-- Invisible Sled for Absolute Stability -->
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.6 0.6 0.01"/></geometry>
      <material name="transparent"><color rgba="0 0 0 0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.6 0.6 0.01"/></geometry>
    </collision>
    <xacro:box_inertia m="0.1" w="0.6" h="0.6" d="0.01"/>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_link"/><child link="Pelvis"/>
    <origin xyz="0 0 0.94" rpy="0 0 0"/>
  </joint>
  <gazebo reference="base_link">
    <!-- Frictionless sled so it doesn't drag -->
    <mu1>0.0</mu1><mu2>0.0</mu2>
  </gazebo>

  <!-- Pelvis -->
  <link name="Pelvis">
    <visual><geometry><box size="0.2 0.3 0.15"/></geometry><material name="blue"/></visual>
    <collision><geometry><box size="0.2 0.3 0.15"/></geometry></collision>
    <xacro:ballast_inertia m="50.0" w="0.2" h="0.3" d="0.15"/>
  </link>
  <gazebo reference="Pelvis"><material>Gazebo/Blue</material></gazebo>

  <!-- Wheels attached to Lower Legs -->
  <link name="left_wheel">
    <visual><geometry><sphere radius="0.05"/></geometry><material name="black"/></visual>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <xacro:sphere_inertia m="2.0" r="0.05"/>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="LeftLowerLeg"/><child link="left_wheel"/>
    <origin xyz="0 0 -0.4" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <visual><geometry><sphere radius="0.05"/></geometry><material name="black"/></visual>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <xacro:sphere_inertia m="2.0" r="0.05"/>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="RightLowerLeg"/><child link="right_wheel"/>
    <origin xyz="0 0 -0.4" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <!-- Trunk -->
  <link name="LowerTrunk">
    <visual><geometry><box size="0.15 0.25 0.2"/></geometry><material name="white"/></visual>
    <collision><geometry><box size="0.15 0.25 0.2"/></geometry></collision>
    <xacro:box_inertia m="5.0" w="0.15" h="0.25" d="0.2"/>
  </link>
  <joint name="jL5S1_roty" type="fixed">
    <parent link="Pelvis"/><child link="LowerTrunk"/><axis xyz="0 1 0"/>
    <origin xyz="0 0 0.1"/><limit effort="100" velocity="1.0" lower="-0.5" upper="1.5"/>
  </joint>
  <gazebo reference="LowerTrunk"><material>Gazebo/White</material></gazebo>

  <link name="UpperTrunk">
    <visual><geometry><box size="0.15 0.25 0.2"/></geometry><material name="white"/></visual>
    <collision><geometry><box size="0.15 0.25 0.2"/></geometry></collision>
    <xacro:box_inertia m="5.0" w="0.15" h="0.25" d="0.2"/>
  </link>
  <joint name="jT9T8_roty" type="fixed">
    <parent link="LowerTrunk"/><child link="UpperTrunk"/><axis xyz="0 1 0"/>
    <origin xyz="0 0 0.2"/><limit effort="100" velocity="1.0" lower="-0.2" upper="0.7"/>
  </joint>
  <gazebo reference="UpperTrunk"><material>Gazebo/White</material></gazebo>

  <!-- Head -->
  <link name="Head">
    <visual>
      <geometry><sphere radius="0.1"/></geometry>
      <material name="grey"/>
    </visual>
    <!-- Left Eye -->
    <visual>
      <origin xyz="0.08 0.04 0.05" rpy="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="black"/>
    </visual>
    <!-- Right Eye -->
    <visual>
      <origin xyz="0.08 -0.04 0.05" rpy="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="black"/>
    </visual>
    <collision><geometry><sphere radius="0.1"/></geometry></collision>
    <xacro:sphere_inertia m="2.0" r="0.1"/>
  </link>
  <joint name="jT1C7_roty" type="fixed">
    <parent link="UpperTrunk"/><child link="Head"/><axis xyz="0 1 0"/>
    <origin xyz="0 0 0.2"/><limit effort="10" velocity="1.0" lower="-0.5" upper="0.5"/>
  </joint>
  <gazebo reference="Head"><material>Gazebo/Grey</material></gazebo>

  <!-- LEGS -->
  <xacro:macro name="archer_leg" params="side reflect">
    <link name="${side}UpperLeg">
      <visual><geometry><cylinder radius="0.05" length="0.4"/></geometry><material name="blue"/></visual>
      <collision><geometry><cylinder radius="0.05" length="0.4"/></geometry></collision>
      <xacro:cylinder_inertia m="3.0" r="0.05" l="0.4"/>
    </link>
    <joint name="j${side}Hip_roty" type="fixed">
      <parent link="Pelvis"/><child link="${side}UpperLeg"/><axis xyz="0 1 0"/>
      <origin xyz="0 ${reflect*0.1} -0.1"/><limit effort="50" velocity="1.0" lower="-1.5" upper="0.5"/>
    </joint>
    <gazebo reference="${side}UpperLeg"><material>Gazebo/Blue</material></gazebo>

    <link name="${side}LowerLeg">
      <visual><geometry><cylinder radius="0.04" length="0.4"/></geometry><material name="blue"/></visual>
      <collision><geometry><cylinder radius="0.04" length="0.4"/></geometry></collision>
      <xacro:cylinder_inertia m="2.0" r="0.04" l="0.4"/>
    </link>
    <joint name="j${side}Knee_roty" type="fixed">
      <parent link="${side}UpperLeg"/><child link="${side}LowerLeg"/><axis xyz="0 1 0"/>
      <origin xyz="0 0 -0.4"/><limit effort="50" velocity="1.0" lower="0" upper="2.0"/>
    </joint>
    <gazebo reference="${side}LowerLeg"><material>Gazebo/Blue</material></gazebo>
  </xacro:macro>

  <xacro:archer_leg side="Left" reflect="1"/>
  <xacro:archer_leg side="Right" reflect="-1"/>

  <!-- ARMS -->
  <xacro:macro name="archer_arm" params="side reflect">
    <link name="${side}UpperArm">
      <visual><geometry><cylinder radius="0.03" length="0.3"/></geometry><material name="white"/></visual>
      <collision><geometry><cylinder radius="0.03" length="0.3"/></geometry></collision>
      <xacro:cylinder_inertia m="1.5" r="0.03" l="0.3"/>
    </link>
    <joint name="j${side}Shoulder_roty" type="fixed">
      <parent link="UpperTrunk"/><child link="${side}UpperArm"/><axis xyz="0 1 0"/>
      <origin xyz="0 ${reflect*0.2} 0.1"/><limit effort="30" velocity="1.0" lower="-1.5" upper="1.5"/>
    </joint>
    <gazebo reference="${side}UpperArm"><material>Gazebo/White</material></gazebo>

    <link name="${side}LowerArm">
      <visual><geometry><cylinder radius="0.02" length="0.3"/></geometry><material name="white"/></visual>
      <collision><geometry><cylinder radius="0.02" length="0.3"/></geometry></collision>
      <xacro:cylinder_inertia m="1.0" r="0.02" l="0.3"/>
    </link>
    <joint name="j${side}Elbow_roty" type="fixed">
      <parent link="${side}UpperArm"/><child link="${side}LowerArm"/><axis xyz="0 1 0"/>
      <origin xyz="0 0 -0.3"/><limit effort="30" velocity="1.0" lower="-2.0" upper="0"/>
    </joint>
    <gazebo reference="${side}LowerArm"><material>Gazebo/White</material></gazebo>

    <link name="${side}Hand">
      <visual><geometry><sphere radius="0.04"/></geometry><material name="grey"/></visual>
      <collision><geometry><sphere radius="0.04"/></geometry></collision>
      <xacro:sphere_inertia m="0.5" r="0.04"/>
    </link>
    <joint name="j${side}Wrist_fixed" type="fixed">
      <parent link="${side}LowerArm"/><child link="${side}Hand"/>
      <origin xyz="0 0 -0.15"/>
    </joint>
    <gazebo reference="${side}Hand"><material>Gazebo/Grey</material></gazebo>
  </xacro:macro>

  <xacro:archer_arm side="Left" reflect="1"/>
  <xacro:archer_arm side="Right" reflect="-1"/>

</robot>
