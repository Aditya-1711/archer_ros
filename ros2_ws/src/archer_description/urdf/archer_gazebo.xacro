<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo>

    <!-- Joint State Publisher (Fixes No Transform error) -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.2</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <max_angular_acceleration>2.5</max_angular_acceleration>
      <max_velocity>2.0</max_velocity>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <publish_odom_tf>true</publish_odom_tf>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Sensors Definition -->
  <gazebo reference="head_camera_link">
    <!-- RGB Camera (Proven to work on WSL) -->
    <sensor name="head_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>2</update_rate>
      <visualize>true</visualize>
      <topic>/archer/camera/image_raw</topic>
      <gz_frame_id>head_camera_link</gz_frame_id>
      <frame_id>head_camera_link</frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.1</near><far>100</far></clip>
      </camera>
    </sensor>

    <!-- Depth Camera for 3D Voxels -->
    <sensor name="head_camera_depth" type="depth_camera">
      <pose>0 0 0 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>5</update_rate>
      <visualize>false</visualize>
      <topic>/archer/camera/depth</topic>
      <gz_frame_id>head_camera_link</gz_frame_id>
      <frame_id>head_camera_link</frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
        </image>
        <clip><near>0.1</near><far>10.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="base_lidar_link">
    <!-- Lidar on Head to ensure horizontal scans -->
    <!-- Lidar (CPU lidar - gpu_lidar silently fails in WSL without hardware GPU) -->
    <sensor name="base_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>base_lidar_link</gz_frame_id>
      <frame_id>base_lidar_link</frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.40</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Torso Lidar (360 degrees, ignores body) -->
  <gazebo reference="torso_lidar_link">
    <sensor name="torso_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>/scan_torso</topic>
      <gz_frame_id>torso_lidar_link</gz_frame_id>
      <frame_id>torso_lidar_link</frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.40</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- IMU for SLAM and Sensor Fusion -->
  <gazebo reference="base_link">
    <!-- IMU -->
    <sensor name="imu_sensor" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>true</visualize>
      <topic>/imu</topic>
      <gz_frame_id>base_link</gz_frame_id>
      <frame_id>base_link</frame_id>
    </sensor>
  </gazebo>

  <!-- Physics Properties -->
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>10.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>10.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

</robot>
