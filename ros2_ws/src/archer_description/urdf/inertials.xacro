<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Box Inertia Macro -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12.0) * (h*h + d*d)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12.0) * (w*w + d*d)}" iyz="0.0"
               izz="${(m/12.0) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder Inertia Macro -->
  <xacro:macro name="cylinder_inertia" params="m r l">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12.0) * (3*r*r + l*l)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12.0) * (3*r*r + l*l)}" iyz="0.0"
               izz="${(m/2.0) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- Sphere Inertia Macro -->
  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${(2.0/5.0) * m * (r*r)}" ixy="0.0" ixz="0.0"
               iyy="${(2.0/5.0) * m * (r*r)}" iyz="0.0"
               izz="${(2.0/5.0) * m * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- Ballast Inertia Macro (Virtual Gyroscope for Extreme Stability) -->
  <xacro:macro name="ballast_inertia" params="m w h d">
    <inertial>
      <!-- Standard anchor to avoid physics solver glitches -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="100.0" ixy="0.0" ixz="0.0"
               iyy="100.0" iyz="0.0"
               izz="${(m/12.0) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

</robot>
