<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="archer_world">
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- =======================================================================
         BUNGALOW STRUCTURE (Modern High-Tech)
         ======================================================================= -->

    <!-- Outer Perimeter Walls -->
    <model name="exterior_walls">
      <static>true</static>
      <link name="link">
        <!-- North Wall -->
        <visual name="north_v"><pose>0 10 1.5 0 0 0</pose><geometry><box><size>20 0.2 3</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <collision name="north_c"><pose>0 10 1.5 0 0 0</pose><geometry><box><size>20 0.2 3</size></box></geometry></collision>
        
        <!-- South Wall (with Entrance) -->
        <visual name="south_v1"><pose>-6 -10 1.5 0 0 0</pose><geometry><box><size>8 0.2 3</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <visual name="south_v2"><pose>6 -10 1.5 0 0 0</pose><geometry><box><size>8 0.2 3</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <collision name="south_c1"><pose>-6 -10 1.5 0 0 0</pose><geometry><box><size>8 0.2 3</size></box></geometry></collision>
        <collision name="south_c2"><pose>6 -10 1.5 0 0 0</pose><geometry><box><size>8 0.2 3</size></box></geometry></collision>

        <!-- East Wall -->
        <visual name="east_v"><pose>10 0 1.5 0 0 0</pose><geometry><box><size>0.2 20 3</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <collision name="east_c"><pose>10 0 1.5 0 0 0</pose><geometry><box><size>0.2 20 3</size></box></geometry></collision>

        <!-- West Wall -->
        <visual name="west_v"><pose>-10 0 1.5 0 0 0</pose><geometry><box><size>0.2 20 3</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <collision name="west_c"><pose>-10 0 1.5 0 0 0</pose><geometry><box><size>0.2 20 3</size></box></geometry></collision>
      </link>
    </model>

    <!-- Interior Partitions -->
    <model name="interior_walls">
      <static>true</static>
      <link name="link">
        <!-- Living/Kitchen Divider -->
        <visual name="v1"><pose>0 -2 1.5 0 0 0</pose><geometry><box><size>10 0.15 3</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="c1"><pose>0 -2 1.5 0 0 0</pose><geometry><box><size>10 0.15 3</size></box></geometry></collision>
        
        <!-- Garage Wall -->
        <visual name="v2"><pose>-5 3 1.5 0 0 1.57</pose><geometry><box><size>14 0.15 3</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
        <collision name="c2"><pose>-5 3 1.5 0 0 1.57</pose><geometry><box><size>14 0.15 3</size></box></geometry></collision>

        <!-- Bedroom 1 -->
        <visual name="v3"><pose>5 5 1.5 0 0 0</pose><geometry><box><size>4 0.15 3</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="v4"><pose>3 7.5 1.5 0 0 1.57</pose><geometry><box><size>5 0.15 3</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <collision name="c3"><pose>5 5 1.5 0 0 0</pose><geometry><box><size>4 0.15 3</size></box></geometry></collision>
        <collision name="c4"><pose>3 7.5 1.5 0 0 1.57</pose><geometry><box><size>5 0.15 3</size></box></geometry></collision>
      </link>
    </model>

    <!-- =======================================================================
         FURNITURE & ASSETS
         ======================================================================= -->

    <!-- Living Room -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sofa</uri>
      <name>living_sofa</name>
      <pose>0 5 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Bookshelf</uri>
      <name>living_bookshelf</name>
      <pose>-3 9.8 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Dining%20Table</uri>
      <name>living_dining_table</name>
      <pose>0 7 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Chair</uri>
      <name>dining_chair_1</name>
      <pose>1 7 0 0 0 -1.57</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Chair</uri>
      <name>dining_chair_2</name>
      <pose>-1 7 0 0 0 1.57</pose>
      <static>true</static>
    </include>

    <!-- Kitchen -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/KitchenSink</uri>
      <name>kitchen_sink</name>
      <pose>2 -6 0 0 0 1.57</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oven</uri>
      <name>kitchen_oven</name>
      <pose>4 -6 0 0 0 1.57</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Refrigerator</uri>
      <name>fridge</name>
      <pose>2.0 -4.0 0 0 0 -1.57</pose>
      <static>true</static>
    </include>

    <!-- Bedrooms / Bathrooms -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Bed</uri>
      <name>master_bed</name>
      <pose>7 7 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Toilet</uri>
      <name>master_toilet</name>
      <pose>5 8 0 0 0 1.57</pose>
      <static>true</static>
    </include>

    <!-- Outside / Garage -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Stop%20Sign</uri>
      <pose>6.0 8.0 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/SUV</uri>
      <name>suv_car</name>
      <pose>-7.5 0 0.0 0 0 0</pose>
      <static>true</static>
    </include>
  </world>
</sdf>
