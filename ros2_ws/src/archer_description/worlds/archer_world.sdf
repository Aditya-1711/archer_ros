<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="archer_world">
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- =======================================================================
         BUNGALOW STRUCTURE (Modern High-Tech)
         ======================================================================= -->

    <!-- Outer Perimeter Walls -->
    <model name="exterior_walls">
      <static>true</static>
      <link name="link">
        <!-- North Wall -->
        <visual name="north_v"><pose>0 10 1.5 0 0 0</pose><geometry><box><size>20 0.2 3</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <collision name="north_c"><pose>0 10 1.5 0 0 0</pose><geometry><box><size>20 0.2 3</size></box></geometry></collision>
        
        <!-- South Wall (with Entrance) -->
        <visual name="south_v1"><pose>-6 -10 1.5 0 0 0</pose><geometry><box><size>8 0.2 3</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <visual name="south_v2"><pose>6 -10 1.5 0 0 0</pose><geometry><box><size>8 0.2 3</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <collision name="south_c1"><pose>-6 -10 1.5 0 0 0</pose><geometry><box><size>8 0.2 3</size></box></geometry></collision>
        <collision name="south_c2"><pose>6 -10 1.5 0 0 0</pose><geometry><box><size>8 0.2 3</size></box></geometry></collision>

        <!-- East Wall -->
        <visual name="east_v"><pose>10 0 1.5 0 0 0</pose><geometry><box><size>0.2 20 3</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <collision name="east_c"><pose>10 0 1.5 0 0 0</pose><geometry><box><size>0.2 20 3</size></box></geometry></collision>

        <!-- West Wall -->
        <visual name="west_v"><pose>-10 0 1.5 0 0 0</pose><geometry><box><size>0.2 20 3</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <collision name="west_c"><pose>-10 0 1.5 0 0 0</pose><geometry><box><size>0.2 20 3</size></box></geometry></collision>
      </link>
    </model>

    <!-- Interior Partitions -->
    <model name="interior_walls">
      <static>true</static>
      <link name="link">
        <!-- Living/Kitchen Divider -->
        <visual name="v1"><pose>0 -2 1.5 0 0 0</pose><geometry><box><size>10 0.15 3</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="c1"><pose>0 -2 1.5 0 0 0</pose><geometry><box><size>10 0.15 3</size></box></geometry></collision>
        
        <!-- Garage Wall -->
        <visual name="v2"><pose>-5 3 1.5 0 0 1.57</pose><geometry><box><size>14 0.15 3</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
        <collision name="c2"><pose>-5 3 1.5 0 0 1.57</pose><geometry><box><size>14 0.15 3</size></box></geometry></collision>

        <!-- Bedroom 1 -->
        <visual name="v3"><pose>5 5 1.5 0 0 0</pose><geometry><box><size>4 0.15 3</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="v4"><pose>3 7.5 1.5 0 0 1.57</pose><geometry><box><size>5 0.15 3</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <collision name="c3"><pose>5 5 1.5 0 0 0</pose><geometry><box><size>4 0.15 3</size></box></geometry></collision>
        <collision name="c4"><pose>3 7.5 1.5 0 0 1.57</pose><geometry><box><size>5 0.15 3</size></box></geometry></collision>
      </link>
    </model>

    <!-- =======================================================================
         FURNITURE & ASSETS
         ======================================================================= -->

    <!-- Living Room: Large TV & Console -->
    <model name="entertainment_unit">
      <static>true</static>
      <pose>0 9.8 0.5 0 0 0</pose>
      <link name="link">
        <visual name="v_tv"><pose>0 0 1.0 0 0 0</pose><geometry><box><size>3 0.05 1.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><emissive>0.1 0.1 0.1 1</emissive></material></visual>
        <visual name="v_stand"><pose>0 0 0 0 0 0</pose><geometry><box><size>3.5 0.4 0.4</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name="c_stand"><geometry><box><size>3.5 0.4 0.4</size></box></geometry></collision>
      </link>
    </model>

    <!-- Living Room: L-Shaped Sofa -->
    <model name="modern_sofa">
      <static>true</static>
      <pose>0 5 0.4 0 0 0</pose>
      <link name="link">
        <visual name="base"><geometry><box><size>4 1.2 0.4</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="back"><pose>0 0.5 0.4 0 0 0</pose><geometry><box><size>4 0.2 0.8</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>4 1.2 0.8</size></box></geometry></collision>
      </link>
    </model>

    <!-- Living Room: Coffee Table -->
    <model name="coffee_table">
      <static>true</static>
      <pose>0 7 0.2 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.5 0.8 0.4</size></box></geometry><material><ambient>0.4 0.2 0 1</ambient><diffuse>0.4 0.2 0 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>1.5 0.8 0.4</size></box></geometry></collision>
      </link>
    </model>

    <!-- SOFA Initial (S) -->
    <model name="initial_sofa">
      <static>true</static>
      <pose>0 5 1.5 0 0 0</pose>
      <link name="link">
        <visual name="v1"><pose>0 0.15 0 0 0 1.57</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="v2"><pose>-0.2 0.1 0 0 0 0</pose><geometry><box><size>0.1 0.2 0.05</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="v3"><pose>0 0 0 0 0 1.57</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="v4"><pose>0.2 -0.1 0 0 0 0</pose><geometry><box><size>0.1 0.2 0.05</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="v5"><pose>0 -0.15 0 0 0 1.57</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
      </link>
    </model>

    <!-- TV Initial (T) -->
    <model name="initial_tv">
      <static>true</static>
      <pose>0 9.8 1.8 0 0 0</pose>
      <link name="link">
        <visual name="v1"><pose>0 0.15 0 0 0 1.57</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="v2"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
      </link>
    </model>

    <!-- BED Initial (B) -->
    <model name="initial_bed">
      <static>true</static>
      <pose>7 7 1.5 0 0 0</pose>
      <link name="link">
        <visual name="v1"><pose>-0.2 0 0 0 0 0</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="v2"><pose>0 0.15 0 0 0 1.57</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="v3"><pose>0 0 0 0 0 1.57</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="v4"><pose>0 -0.15 0 0 0 1.57</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="v5"><pose>0.2 0 0 0 0 0</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
      </link>
    </model>

    <!-- Kitchen: Island & Tops -->
    <model name="kitchen_island">
      <static>true</static>
      <pose>2 -5 0.5 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>4 1.2 0.9</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="v_top"><pose>0 0 0.46 0 0 0</pose><geometry><box><size>4.1 1.3 0.04</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>4 1.2 0.9</size></box></geometry></collision>
      </link>
    </model>

    <!-- Master Bedroom: Bed -->
    <model name="master_bed">
      <static>true</static>
      <pose>7 7 0.3 0 0 0</pose>
      <link name="link">
        <visual name="v_mattress"><geometry><box><size>2 2.2 0.4</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="v_headboard"><pose>0 1.1 0.5 0 0 0</pose><geometry><box><size>2.2 0.1 1</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>2 2.2 0.4</size></box></geometry></collision>
      </link>
    </model>

    <!-- Master Bedroom: Wardrobe -->
    <model name="master_wardrobe">
      <static>true</static>
      <pose>9 7 1.2 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.6 3 2.4</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.6 3 2.4</size></box></geometry></collision>
      </link>
    </model>

    <!-- MASTER BEDROOM Initial (M) -->
    <model name="initial_master_bedroom">
      <static>true</static>
      <pose>7 9 2.5 0 0 0</pose>
      <link name="link">
        <visual name="v1"><pose>-0.2 0 0 0 0 0</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>1 0 1 1</ambient><diffuse>1 0 1 1</diffuse><emissive>1 0 1 1</emissive></material></visual>
        <visual name="v2"><pose>0.2 0 0 0 0 0</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>1 0 1 1</ambient><diffuse>1 0 1 1</diffuse><emissive>1 0 1 1</emissive></material></visual>
        <visual name="v3"><pose>0 0.15 0 0 0 0.78</pose><geometry><box><size>0.1 0.3 0.05</size></box></geometry><material><ambient>1 0 1 1</ambient><diffuse>1 0 1 1</diffuse><emissive>1 0 1 1</emissive></material></visual>
        <visual name="v4"><pose>0 0.15 0 0 0 -0.78</pose><geometry><box><size>0.1 0.3 0.05</size></box></geometry><material><ambient>1 0 1 1</ambient><diffuse>1 0 1 1</diffuse><emissive>1 0 1 1</emissive></material></visual>
      </link>
    </model>

    <!-- KITCHEN Initial (K) -->
    <model name="initial_kitchen">
      <static>true</static>
      <pose>2 -6.5 2.5 0 0 0</pose>
      <link name="link">
        <visual name="v1"><pose>-0.2 0 0 0 0 0</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse><emissive>0 1 0 1</emissive></material></visual>
        <visual name="v2"><pose>0.1 0.1 0 0 0 -0.78</pose><geometry><box><size>0.1 0.3 0.05</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse><emissive>0 1 0 1</emissive></material></visual>
        <visual name="v3"><pose>0.1 -0.1 0 0 0 0.78</pose><geometry><box><size>0.1 0.3 0.05</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse><emissive>0 1 0 1</emissive></material></visual>
      </link>
    </model>

    <!-- LIVING ROOM Initial (L) -->
    <model name="initial_living_room">
      <static>true</static>
      <pose>0 1 2.5 0 0 0</pose>
      <link name="link">
        <visual name="v1"><pose>-0.2 0 0 0 0 0</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse><emissive>0 0 1 1</emissive></material></visual>
        <visual name="v2"><pose>0 -0.15 0 0 0 1.57</pose><geometry><box><size>0.1 0.3 0.05</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse><emissive>0 0 1 1</emissive></material></visual>
      </link>
    </model>

    <!-- GARAGE Initial (G) -->
    <model name="initial_garage">
      <static>true</static>
      <pose>-7.5 5 2.5 0 0 0</pose>
      <link name="link">
        <visual name="v1"><pose>0 0.15 0 0 0 1.57</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse><emissive>0.5 0.5 0.5 1</emissive></material></visual>
        <visual name="v2"><pose>-0.2 0 0 0 0 0</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse><emissive>0.5 0.5 0.5 1</emissive></material></visual>
        <visual name="v3"><pose>0 -0.15 0 0 0 1.57</pose><geometry><box><size>0.1 0.4 0.05</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse><emissive>0.5 0.5 0.5 1</emissive></material></visual>
        <visual name="v4"><pose>0.2 -0.05 0 0 0 0</pose><geometry><box><size>0.1 0.2 0.05</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse><emissive>0.5 0.5 0.5 1</emissive></material></visual>
      </link>
    </model>

    <!-- Garage: Vehicles (Placeholder Boxes) -->
    <model name="garage_vehicle">
      <static>true</static>
      <pose>-7.5 0 0.7 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>2 4 1.4</size></box></geometry><material><ambient>0.2 0.2 0.8 1</ambient><diffuse>0.2 0.2 0.8 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>2 4 1.4</size></box></geometry></collision>
      </link>
    </model>

    <!-- Outdoor: Patio Furniture -->
    <model name="patio_table">
      <static>true</static>
      <pose>0 -15 0.4 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>1.5</radius><length>0.05</length></cylinder></geometry><material><ambient>0.4 0.2 0 1</ambient><diffuse>0.4 0.2 0 1</diffuse></material></visual>
        <visual name="v_leg"><pose>0 0 -0.4 0 0 0</pose><geometry><cylinder><radius>0.1</radius><length>0.8</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>1.5</radius><length>0.05</length></cylinder></geometry></collision>
